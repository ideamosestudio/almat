Options -Indexes
LimitRequestBody 16384
<FilesMatch "(^\.|^error_log$|\.(log|json|ini|bak|old|sql|zip|tar|gz)$)">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cache-Control "no-store, max-age=0"
</IfModule>
