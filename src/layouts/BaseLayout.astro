---
import '@fontsource/dm-sans/latin-300.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/roboto/latin-300.css';
import dmSansFont from '@fontsource/dm-sans/files/dm-sans-latin-300-normal.woff2?url';
import Header from '../components/Header.astro';
import FooterContactForm from '../components/FooterContactForm.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  showContact?: boolean;
}
const { title, description, image, showContact = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = image ?? `${base}/brand/almat-logo-black.webp`;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={dmSansFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#141513" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}/brand/favicon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    {showContact && <FooterContactForm />}
    <Footer />
    <WhatsAppButton />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
