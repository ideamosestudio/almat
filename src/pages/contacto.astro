---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FooterContactForm from '../components/FooterContactForm.astro';
import heroGolden from '../assets/heroes/hero-golden.jpg';
const whatsapp = 'https://wa.me/5491127332222?text=Hola%20ALMAT%2C%20quisiera%20solicitar%20un%20presupuesto.';
---
<BaseLayout title="Contacto | ALMAT Cerramientos" description="Solicitá un presupuesto para aberturas y cerramientos. Showroom en Av. Raúl Scalabrini Ortiz 1022, CABA." showContact={false}>
  <PageHero image={heroGolden} title="Hagamos realidad tu espacio" intro="Contanos tu idea. La hacemos realidad." position="center" align="left"
    primaryCta={{ href: whatsapp, label: 'Escribir por WhatsApp', external: true }}
    secondaryCta={{ href: '#contacto', label: 'Completar formulario' }} />
  <FooterContactForm id="contacto" />
  <section class="contact-showroom light-section" aria-labelledby="showroom-map-title">
    <div class="wrap contact-showroom__heading">
      <div><p class="eyebrow">CONOCÉ LOS DETALLES DE CERCA</p><h2 id="showroom-map-title">Te esperamos en el showroom.</h2></div>
      <a href="https://maps.google.com/?q=Av.+Ra%C3%BAl+Scalabrini+Ortiz+1022,+CABA" target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
    </div>
    <div class="map-section" aria-label="Ubicación del showroom">
      <iframe title="Mapa del showroom ALMAT, Av. Raúl Scalabrini Ortiz 1022, CABA" src="https://www.google.com/maps?q=Av.%20Ra%C3%BAl%20Scalabrini%20Ortiz%201022,+CABA&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</BaseLayout>
