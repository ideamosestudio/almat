---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ActionLink from '../components/ActionLink.astro';
import heroInterior from '../assets/heroes/hero-interior.jpg';
import aluminio from '../assets/projects/interior-en-obra.png';
import cerramientos from '../assets/projects/patio-vidriado.png';
import vidrios from '../assets/projects/lobby-vidrio.png';
import plegadizos from '../assets/projects/terraza-buenos-aires.png';
import pvc from '../assets/projects/aberturas-pvc-dormitorio.png';
import finalImage from '../assets/heroes/hero-pool.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsapp = 'https://wa.me/5491127332222?text=Hola%20ALMAT%2C%20quisiera%20solicitar%20un%20presupuesto.';
const services = [
  { title: 'Aberturas de aluminio', text: 'Fabricación e instalación de aberturas de aluminio de diferentes tamaños, adaptadas a las necesidades de cada proyecto.', image: aluminio, alt: 'Abertura de aluminio de gran formato en una obra contemporánea' },
  { title: 'Cerramientos de aluminio', text: 'Soluciones para integrar, proteger y aprovechar mejor distintos espacios mediante cerramientos de calidad.', image: cerramientos, alt: 'Cerramiento de aluminio y vidrio en un patio residencial' },
  { title: 'Vidrios, espejos y templados', text: 'Colocación de vidrios, espejos de diseño, vidrios de seguridad y templados para proyectos residenciales y comerciales.', image: vidrios, alt: 'Baranda de vidrio templado en un interior contemporáneo' },
  { title: 'Cerramientos vidriados corredizos y plegadizos', text: 'Sistemas que permiten conectar, dividir y transformar espacios interiores y exteriores con flexibilidad.', image: plegadizos, alt: 'Terraza urbana cubierta por una estructura de aluminio y vidrio' },
  { title: 'Aberturas de PVC', text: 'Fabricación e instalación de aberturas de PVC a medida para mejorar el aislamiento térmico, acústico y el confort cotidiano.', image: pvc, alt: 'Abertura de PVC blanca en un dormitorio con vista al jardín' }
];
---
<BaseLayout title="Servicios | ALMAT Cerramientos" description="Aberturas de aluminio y PVC, cerramientos, vidrios, espejos, templados y sistemas corredizos o plegadizos en Buenos Aires.">
  <PageHero
    image={heroInterior}
    title="Precisión en cada detalle"
    intro="Aberturas y cerramientos con diseño y precisión."
    position="center"
    align="left"
    primaryCta={{ href: whatsapp, label: 'Solicitar presupuesto', external: true }}
    secondaryCta={{ href: '#servicios', label: 'Explorar soluciones' }}
  />

  <section class="section light-section" id="servicios">
    <div class="wrap services-intro">
      <h2 class="section-title reveal-title">Una respuesta para cada forma de habitar</h2>
      <p class="body-large reveal-up">Trabajamos la relación entre interior y exterior, luz y protección, apertura y privacidad. Cada sistema se define según el espacio y sus necesidades reales.</p>
    </div>
  </section>

  <section class="light-section">
    {services.map((service, index) => (
      <article class="service-scene" id={`servicio-${index + 1}`}>
        <div class="service-scene__image" data-reveal>
          <Image src={service.image} alt={service.alt} widths={[640, 980, 1400]} sizes="(max-width: 960px) 100vw, 56vw" loading="lazy" />
        </div>
        <div class="service-scene__copy">
          <span class="service-scene__number reveal-up">0{index + 1} / 05</span>
          <h2 class="reveal-title">{service.title}</h2>
          <p class="reveal-up">{service.text}</p>
          <div class="cta-group reveal-up">
            <ActionLink href={whatsapp} label="Consultar esta solución" external />
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="visual-cta dark-zone">
    <Image src={finalImage} alt="Vivienda contemporánea con grandes cerramientos de aluminio y vidrio" widths={[720, 1200, 1920]} sizes="100vw" loading="lazy" data-parallax />
    <div class="wrap visual-cta__content">
      <div>
        <p class="eyebrow reveal-up">TU PROYECTO</p>
        <h2 class="section-title reveal-title">Encontremos la solución adecuada</h2>
      </div>
      <div class="visual-cta__aside reveal-up">
        <p>Contanos qué espacio querés transformar y qué necesidades necesitás resolver.</p>
        <div class="cta-group">
          <ActionLink href={whatsapp} label="Solicitá tu presupuesto" light external />
          <ActionLink href={`${base}/contacto/`} label="Ver contacto" variant="secondary" light />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

