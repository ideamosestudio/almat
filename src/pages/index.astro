---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';

import heroMain from '../assets/heroes/hero-sunset.jpg';
import heroPool from '../assets/heroes/hero-pool.jpg';
import heroInterior from '../assets/heroes/hero-interior.jpg';
import heroGolden from '../assets/heroes/hero-golden.jpg';
import fachadaOndulada from '../assets/projects/fachada-ondulada.png';
import fachadaModerna from '../assets/projects/fachada-moderna.png';
import patio from '../assets/projects/patio-vidriado.png';
import lobby from '../assets/projects/lobby-vidrio.png';
import balcon from '../assets/projects/balcon-vidriado.png';
import pergola from '../assets/projects/instalacion-pergola.png';
import terraza from '../assets/projects/terraza-buenos-aires.png';
import aberturas from '../assets/projects/instalacion-aberturas.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = [
  { title: 'Aberturas de aluminio', image: heroInterior },
  { title: 'Cerramientos de aluminio', image: patio },
  { title: 'Vidrios, espejos y templados', image: lobby },
  { title: 'Cerramientos vidriados corredizos y plegadizos', image: pergola },
  { title: 'Aberturas de PVC', image: aberturas }
];
const gallery = [
  { image: fachadaOndulada, alt: 'Fachada contemporánea con balcones curvos y cerramientos vidriados' },
  { image: balcon, alt: 'Cerramiento de vidrio en balcón de edificio residencial' },
  { image: patio, alt: 'Comedor vidriado integrado a un patio' },
  { image: fachadaModerna, alt: 'Fachada residencial moderna con balcones de vidrio' },
  { image: terraza, alt: 'Terraza urbana en Buenos Aires con cubierta vidriada' }
];
const galleryWithSources = await Promise.all(gallery.map(async (item) => ({
  ...item,
  full: (await getImage({ src: item.image, width: 1800, format: 'webp', quality: 88 })).src
})));
---

<BaseLayout title="ALMAT Cerramientos | Aberturas y cerramientos en Buenos Aires" description="Fabricación e instalación de aberturas, cerramientos de aluminio y vidrio. Tres décadas transformando espacios en Buenos Aires.">
  <section class="home-hero dark-zone">
    <div class="home-hero__media">
      <Image src={heroMain} alt="Living contemporáneo conectado a un balcón mediante amplios cerramientos de aluminio" widths={[720, 1200, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="home-hero__content wrap">
      <p class="eyebrow home-hero__eyebrow reveal-up">ALMAT / ABERTURAS Y CERRAMIENTOS</p>
      <h1 class="home-hero__title reveal-title">Espacios que abren nuevas posibilidades.</h1>
      <div class="home-hero__lower reveal-up" data-reveal-delay="2">
        <p class="home-hero__copy">Diseñamos, fabricamos e instalamos aberturas y cerramientos que integran arquitectura, funcionalidad y calidad.</p>
        <div class="hero-actions">
          <a class="text-link" href={`${base}/servicios/`}>Conocé nuestros servicios</a>
          <a class="text-link" href={`${base}/contacto/`}>Solicitá presupuesto</a>
        </div>
      </div>
    </div>
    <span class="scroll-cue">Descubrí</span>
  </section>

  <section class="section light-section">
    <div class="wrap intro-grid">
      <div class="intro-grid__aside reveal-up">
        <p class="eyebrow">ALMAT CERRAMIENTOS</p>
      </div>
      <div class="intro-grid__main">
        <h2 class="section-title reveal-title">Cada espacio merece una solución a su medida.</h2>
        <div class="intro-story">
          <div class="intro-story__copy reveal-up">
            <p>Hace 30 años que trabajamos en la fabricación e instalación de aberturas y cerramientos, combinando experiencia, materiales de calidad y atención personalizada para proyectos residenciales y comerciales.</p>
            <ArrowLink href={`${base}/nosotros/`} label="Conocé ALMAT" />
          </div>
          <div class="image-frame" data-reveal>
            <Image src={fachadaOndulada} alt="Fachada residencial con balcones y paños vidriados" widths={[520, 820, 1100]} sizes="(max-width: 640px) 100vw, 42vw" loading="lazy" data-parallax />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="services-feature dark-section" data-service-list>
    <div class="wrap services-head">
      <div>
        <p class="eyebrow reveal-up">NUESTRAS SOLUCIONES</p>
        <h2 class="section-title reveal-title" style="margin-top:1.25rem">Soluciones que transforman espacios.</h2>
      </div>
      <ArrowLink href={`${base}/servicios/`} label="Explorá nuestros servicios" light />
    </div>
    <div class="service-explorer">
      <div class="service-explorer__images">
        {services.map((service, index) => (
          <div class:list={["service-explorer__image", { "is-active": index === 0 }]} data-service-image>
            <Image src={service.image} alt={service.title} widths={[720, 1080, 1440]} sizes="(max-width: 960px) 100vw, 50vw" loading={index === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      <div class="service-explorer__list">
        {services.map((service, index) => (
          <a href={`${base}/servicios/#servicio-${index + 1}`} class="service-row" data-service-row>
            <span class="service-row__number">0{index + 1}</span>
            <h3>{service.title}</h3>
            <span class="service-row__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="work-section light-section" id="trabajos">
    <div class="wrap work-head">
      <p class="eyebrow reveal-up">NUESTROS TRABAJOS</p>
      <h2 class="section-title reveal-title">La arquitectura se vive en los detalles.</h2>
    </div>
    <div class="wrap masonry-gallery">
      {galleryWithSources.map((item, index) => (
        <button class="gallery-item" type="button" data-lightbox-src={item.full} data-lightbox-alt={item.alt} aria-label={`Ampliar imagen ${index + 1}`} data-reveal>
          <Image src={item.image} alt={item.alt} widths={[520, 860, 1280, 1800]} sizes={index === 4 ? '100vw' : '(max-width: 640px) 100vw, 58vw'} loading="lazy" />
        </button>
      ))}
    </div>
    <dialog class="lightbox" data-lightbox aria-label="Visor de trabajos">
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Cerrar visor">×</button>
      <div class="lightbox__stage"><img src="" alt="" /></div>
      <div class="lightbox__controls">
        <button type="button" data-lightbox-prev>← Anterior</button>
        <span data-lightbox-counter>01 / 05</span>
        <button type="button" data-lightbox-next>Siguiente →</button>
      </div>
    </dialog>
  </section>

  <section class="benefits light-section">
    <div class="wrap benefits__top">
      <p class="eyebrow reveal-up">DISEÑO Y PRESTACIONES</p>
      <h2 class="section-title reveal-title">Belleza que también se siente.</h2>
    </div>
    <div class="wrap benefit-list">
      <div class="benefit-row" data-reveal><span class="benefit-row__number">01</span><h3>Confort térmico y acústico</h3><p>Según la línea, el tipo de vidrio y la instalación, las soluciones adecuadas contribuyen a mejorar el aislamiento y el bienestar interior.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">02</span><h3>Durabilidad y resistencia</h3><p>El aluminio ofrece una respuesta sólida y de bajo mantenimiento para acompañar el uso cotidiano y el paso del tiempo.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">03</span><h3>Seguridad</h3><p>La selección del sistema, los herrajes y los vidrios permite proyectar soluciones acordes a las necesidades de cada ambiente.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">04</span><h3>Versatilidad arquitectónica</h3><p>Perfiles, aperturas y terminaciones se combinan para integrarse con naturalidad a lenguajes arquitectónicos diversos.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">05</span><h3>Materiales reciclables</h3><p>El aluminio puede reciclarse y volver a incorporarse a nuevos ciclos productivos, conservando sus propiedades.</p></div>
    </div>
  </section>

  <section class="trust dark-section">
    <div class="trust__visual">
      <Image src={heroPool} alt="Cerramientos vidriados de gran formato en una vivienda contemporánea" widths={[720, 1080, 1440]} sizes="(max-width: 960px) 100vw, 43vw" loading="lazy" />
      <span class="trust__number">30</span>
    </div>
    <div class="trust__content">
      <p class="eyebrow reveal-up">TRAYECTORIA Y CONFIANZA</p>
      <h2 class="section-title reveal-title">Tres décadas de oficio y evolución.</h2>
      <p class="body-large reveal-up">Una empresa familiar nacida en Caballito, con experiencia en soluciones de aluminio y vidrio para hogares, comercios y proyectos arquitectónicos.</p>
      <div class="partner-names reveal-up" aria-label="Marcas y proveedores">
        <span>Aluar</span><span>Metales del Talar</span><span>Tanit</span><span>Giesse</span><span>Red Ekoglass</span>
      </div>
    </div>
  </section>

  <section class="visual-cta dark-zone">
    <Image src={heroGolden} alt="Interior contemporáneo abierto hacia la ciudad al atardecer" widths={[720, 1200, 1920]} sizes="100vw" loading="lazy" data-parallax />
    <div class="wrap visual-cta__content">
      <div>
        <p class="eyebrow reveal-up">HABLEMOS</p>
        <h2 class="section-title reveal-title">Tu próximo espacio comienza acá.</h2>
      </div>
      <div class="visual-cta__aside reveal-up">
        <p>Contanos qué necesitás. Te ayudamos a encontrar la solución adecuada para tu proyecto.</p>
        <ArrowLink href={`${base}/contacto/`} label="Solicitá tu presupuesto" light />
      </div>
    </div>
  </section>
</BaseLayout>
