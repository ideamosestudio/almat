---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ActionLink.astro';

import heroMain from '../assets/heroes/hero-sunset.jpg';
import heroPool from '../assets/heroes/hero-pool.jpg';
import heroInterior from '../assets/heroes/hero-interior.jpg';
import heroGolden from '../assets/heroes/hero-golden.jpg';
import fachadaOndulada from '../assets/projects/fachada-ondulada.png';
import fachadaModerna from '../assets/projects/fachada-moderna.png';
import patio from '../assets/projects/patio-vidriado.png';
import lobby from '../assets/projects/lobby-vidrio.png';
import balcon from '../assets/projects/balcon-vidriado.png';
import pergola from '../assets/projects/instalacion-pergola.png';
import terraza from '../assets/projects/terraza-buenos-aires.png';
import aberturas from '../assets/projects/instalacion-aberturas.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsapp = 'https://wa.me/5491127332222?text=Hola%20ALMAT%2C%20quisiera%20solicitar%20un%20presupuesto.';
const services = [
  { title: 'Aberturas de aluminio', image: heroInterior },
  { title: 'Cerramientos de aluminio', image: patio },
  { title: 'Vidrios, espejos y templados', image: lobby },
  { title: 'Cerramientos vidriados corredizos y plegadizos', image: pergola },
  { title: 'Aberturas de PVC', image: aberturas }
];
const gallery = [
  { image: fachadaOndulada, alt: 'Fachada contemporánea con balcones curvos y cerramientos vidriados' },
  { image: balcon, alt: 'Cerramiento de vidrio en balcón de edificio residencial' },
  { image: patio, alt: 'Comedor vidriado integrado a un patio' },
  { image: fachadaModerna, alt: 'Fachada residencial moderna con balcones de vidrio' },
  { image: terraza, alt: 'Terraza urbana en Buenos Aires con cubierta vidriada' }
];
const galleryWithSources = await Promise.all(gallery.map(async (item) => ({
  ...item,
  full: (await getImage({ src: item.image, width: 1800, format: 'webp', quality: 88 })).src
})));
---

<BaseLayout title="ALMAT Cerramientos | Aberturas y cerramientos en Buenos Aires" description="Fabricación e instalación de aberturas, cerramientos de aluminio y vidrio. Tres décadas transformando espacios en Buenos Aires.">
  <section class="home-hero dark-zone">
    <div class="home-hero__media">
      <Image src={heroMain} alt="Living contemporáneo conectado a un balcón mediante amplios cerramientos de aluminio" widths={[720, 1200, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="home-hero__content wrap">
      <div class="home-hero__heading">
        <p class="eyebrow home-hero__eyebrow reveal-up">ABERTURAS Y CERRAMIENTOS</p>
        <h1 class="home-hero__title reveal-title" data-hero-title>Espacios que abren nuevas posibilidades.</h1>
      </div>
      <div class="home-hero__lower reveal-up" data-reveal-delay="2">
        <p class="home-hero__copy" data-hero-intro>Fabricamos aberturas y cerramientos con precisión, diseño y calidad.</p>
        <div class="cta-group">
          <ActionLink href={whatsapp} label="Solicitar presupuesto" light external />
          <ActionLink href={`${base}/servicios/`} label="Conocé nuestros servicios" variant="secondary" light />
        </div>
      </div>
    </div>
    <span class="scroll-cue">Descubrí</span>
  </section>

  <section class="factory-statement light-section">
    <div class="wrap factory-statement__grid">
      <div class="factory-statement__content">
        <p class="eyebrow reveal-up">DISEÑO, VENTA Y COLOCACIÓN</p>
        <h2 class="factory-statement__title reveal-title">Somos una fábrica de aberturas de alta prestación.</h2>
        <div class="factory-statement__copy reveal-up">
          <p>Hace 30 años fabricamos e instalamos soluciones que combinan precisión, materiales de calidad y atención personalizada para proyectos residenciales y comerciales.</p>
          <div class="cta-group">
            <ActionLink href={whatsapp} label="Contactanos hoy" external />
            <ActionLink href={`${base}/servicios/`} label="Conocé nuestros servicios" variant="secondary" />
          </div>
        </div>
      </div>
      <div class="factory-statement__image" data-reveal>
        <Image src={fachadaOndulada} alt="Fachada residencial con balcones y paños vidriados" widths={[620, 960, 1300]} sizes="(max-width: 760px) 100vw, 55vw" loading="lazy" data-parallax />
      </div>
    </div>
  </section>

  <section class="capabilities light-section">
    <div class="wrap capabilities__head">
      <p class="eyebrow reveal-up">LO QUE HACEMOS</p>
      <h2 class="section-title reveal-title">Cuatro soluciones. Una misma precisión.</h2>
    </div>
    <div class="wrap capabilities-grid">
      <article class="capability-card" data-reveal>
        <div class="capability-card__image"><Image src={heroInterior} alt="Aberturas de aluminio de gran formato" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 25vw" loading="lazy" /></div>
        <span>01</span><h3>Fabricación e instalación de aberturas de aluminio</h3>
        <p>Fabricamos aberturas de aluminio a medida para responder con precisión a cada proyecto.</p>
        <ActionLink href={whatsapp} label="Quiero asesoramiento" external />
      </article>
      <article class="capability-card" data-reveal data-reveal-delay="1">
        <div class="capability-card__image"><Image src={patio} alt="Cerramiento de aluminio integrado a un patio" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 25vw" loading="lazy" /></div>
        <span>02</span><h3>Cerramientos de aluminio</h3>
        <p>Instalamos cerramientos de aluminio para integrar ambientes y aprovechar mejor cada espacio.</p>
        <ActionLink href={whatsapp} label="Consultar cerramientos" external />
      </article>
      <article class="capability-card" data-reveal data-reveal-delay="2">
        <div class="capability-card__image"><Image src={lobby} alt="Vidrio templado aplicado en un interior contemporáneo" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 25vw" loading="lazy" /></div>
        <span>03</span><h3>Vidrios, espejos y templados</h3>
        <p>Colocamos espejos de diseño, vidrios de seguridad y templados para cada necesidad.</p>
        <ActionLink href={whatsapp} label="Hacer una consulta" external />
      </article>
      <article class="capability-card" data-reveal data-reveal-delay="3">
        <div class="capability-card__image"><Image src={pergola} alt="Cerramiento vidriado corredizo en una terraza" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 25vw" loading="lazy" /></div>
        <span>04</span><h3>Cerramientos corredizos y plegadizos de vidrio</h3>
        <p>Instalamos sistemas vidriados que conectan y transforman ambientes interiores y exteriores.</p>
        <ActionLink href={whatsapp} label="Solicitar presupuesto" external />
      </article>
    </div>
  </section>

  <section class="services-feature dark-section" data-service-list>
    <div class="wrap services-head">
      <p class="eyebrow reveal-up">NUESTRAS SOLUCIONES</p>
      <h2 class="section-title reveal-title">Soluciones que <em>transforman</em> espacios.</h2>
      <p class="lead reveal-up">Cada proyecto combina uso, escala y materialidad. Te ayudamos a definir el sistema indicado.</p>
      <p class="services-head__meta reveal-up">ALUMINIO · VIDRIO · PVC</p>
    </div>
    <div class="service-explorer">
      <div class="service-explorer__images">
        {services.map((service, index) => (
          <div class:list={["service-explorer__image", { "is-active": index === 0 }]} data-service-image>
            <Image src={service.image} alt={service.title} widths={[720, 1080, 1440]} sizes="(max-width: 960px) 100vw, 50vw" loading={index === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      <div class="service-explorer__list">
        {services.map((service, index) => (
          <a href={`${base}/servicios/#servicio-${index + 1}`} class="service-row" data-service-row>
            <span class="service-row__number">0{index + 1}</span>
            <h3>{service.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="work-section light-section" id="trabajos">
    <div class="wrap work-head section-composition section-composition--split">
      <p class="eyebrow reveal-up">NUESTROS TRABAJOS</p>
      <div class="section-support">
        <h2 class="section-title reveal-title">La arquitectura se vive en los detalles.</h2>
        <p class="lead reveal-up">Una selección de soluciones realizadas para viviendas, terrazas y fachadas.</p>
        <div class="cta-group reveal-up"><ActionLink href={whatsapp} label="Quiero un proyecto así" external /></div>
      </div>
    </div>
    <div class="wrap masonry-gallery">
      {galleryWithSources.map((item, index) => (
        <button class="gallery-item" type="button" data-lightbox-src={item.full} data-lightbox-alt={item.alt} aria-label={`Ampliar imagen ${index + 1}`} data-reveal>
          <Image src={item.image} alt={item.alt} widths={[520, 860, 1280, 1800]} sizes={index === 4 ? '100vw' : '(max-width: 640px) 100vw, 58vw'} loading="lazy" />
        </button>
      ))}
    </div>
    <dialog class="lightbox" data-lightbox aria-label="Visor de trabajos">
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Cerrar visor">×</button>
      <div class="lightbox__stage"><img src="" alt="" /></div>
      <div class="lightbox__controls">
        <button type="button" data-lightbox-prev>← Anterior</button>
        <span data-lightbox-counter>01 / 05</span>
        <button type="button" data-lightbox-next>Siguiente →</button>
      </div>
    </dialog>
  </section>

  <section class="benefits light-section">
    <div class="wrap benefits__top section-composition section-composition--split">
      <p class="eyebrow reveal-up">DISEÑO Y PRESTACIONES</p>
      <div class="section-support">
        <h2 class="section-title reveal-title">Belleza que también se siente.</h2>
        <p class="lead reveal-up">Elegir bien perfiles, vidrios y sistemas mejora el uso cotidiano de cada ambiente.</p>
        <div class="cta-group reveal-up"><ActionLink href={whatsapp} label="Elegir la solución adecuada" external /></div>
      </div>
    </div>
    <div class="wrap benefit-list">
      <div class="benefit-row" data-reveal><span class="benefit-row__number">01</span><h3>Climatización e insonorización</h3><p>Según la línea, el vidrio y la instalación, una abertura adecuada puede contribuir al aislamiento térmico y acústico de los ambientes.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">02</span><h3>Ecología y sustentabilidad</h3><p>El aluminio es un material reciclable que puede reincorporarse a nuevos ciclos productivos conservando sus propiedades.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">03</span><h3>Durabilidad y economía</h3><p>Su resistencia y bajo mantenimiento favorecen una vida útil prolongada y un buen desempeño cotidiano.</p></div>
      <div class="benefit-row" data-reveal><span class="benefit-row__number">04</span><h3>Seguridad</h3><p>Perfiles, herrajes y vidrios se seleccionan de acuerdo con las necesidades de protección y uso de cada proyecto.</p></div>
    </div>
  </section>

  <section class="trust dark-section">
    <div class="trust__visual">
      <Image src={heroPool} alt="Cerramientos vidriados de gran formato en una vivienda contemporánea" widths={[720, 1080, 1440]} sizes="(max-width: 960px) 100vw, 43vw" loading="lazy" />
      <span class="trust__number">30</span>
    </div>
    <div class="trust__content">
      <p class="eyebrow reveal-up">TRAYECTORIA Y CONFIANZA</p>
      <h2 class="section-title reveal-title">Tres décadas de oficio y evolución.</h2>
      <p class="body-large reveal-up">Una empresa familiar nacida en Caballito, con experiencia en soluciones de aluminio y vidrio para hogares, comercios y proyectos arquitectónicos.</p>
      <div class="cta-group"><ActionLink href={whatsapp} label="Contactanos hoy" light external /></div>
    </div>
  </section>

  <section class="logo-strip dark-section" aria-label="Marcas con las que trabajamos">
    <div class="wrap logo-strip__inner">
      <div class="logo-strip__logos">
        <img src={`${base}/partners/blindex.webp`} alt="Blindex" />
        <img src={`${base}/partners/vasa.webp`} alt="VASA Vidriería Argentina" />
        <img src={`${base}/partners/aluar.webp`} alt="Aluar" />
        <img src={`${base}/partners/casasegat.webp`} alt="Casa Segat" />
        <img src={`${base}/partners/mdt.webp`} alt="MDT Tecnología en Aluminio y Vidrio" />
        <img src={`${base}/partners/vilo.webp`} alt="Vilo" />
      </div>
    </div>
  </section>

  <section class="visual-cta dark-zone">
    <Image src={heroGolden} alt="Interior contemporáneo abierto hacia la ciudad al atardecer" widths={[720, 1200, 1920]} sizes="100vw" loading="lazy" data-parallax />
    <div class="wrap visual-cta__content">
      <div>
        <p class="eyebrow reveal-up">HABLEMOS</p>
        <h2 class="section-title reveal-title">Tu próximo espacio comienza acá.</h2>
      </div>
      <div class="visual-cta__aside reveal-up">
        <p>Contanos qué necesitás. Te ayudamos a encontrar la solución adecuada para tu proyecto.</p>
        <div class="cta-group"><ActionLink href={whatsapp} label="Solicitá tu presupuesto" light external /></div>
      </div>
    </div>
  </section>
</BaseLayout>
