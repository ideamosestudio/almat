---
import ArrowIcon from "./ArrowIcon.astro";
interface Props { id?: string; }
const { id = 'consulta' } = Astro.props;
---

<section class="footer-contact dark-section" id={id} aria-labelledby="footer-contact-title">
  <div class="wrap footer-contact__layout">
    <div class="footer-contact__intro">
      <p class="eyebrow">CONTANOS TU PROYECTO</p>
      <h2 class="section-title" id="footer-contact-title">Hablemos de tu próximo espacio</h2>
      <p class="footer-contact__copy">Dejanos tus datos y te asesoramos para encontrar la solución adecuada.</p>
      <div class="contact-channels">
        <a href="https://wa.me/5491127332222" target="_blank" rel="noreferrer">
          <span class="contact-channels__label">01 / Hablemos</span>
          <span class="contact-channels__value">WhatsApp <span aria-hidden="true"><ArrowIcon /></span></span>
          <span class="contact-channels__detail">11 2733-2222</span>
        </a>
        <a href="mailto:almatcerramientos@gmail.com">
          <span class="contact-channels__label">02 / Escribinos</span>
          <span class="contact-channels__value contact-channels__email">almatcerramientos@gmail.com <span aria-hidden="true"><ArrowIcon /></span></span>
        </a>
        <a href="https://maps.google.com/?q=Av.+Ra%C3%BAl+Scalabrini+Ortiz+1022,+CABA" target="_blank" rel="noreferrer">
          <span class="contact-channels__label">03 / Nuestro showroom</span>
          <span class="contact-channels__value">Scalabrini Ortiz 1022 <span aria-hidden="true"><ArrowIcon /></span></span>
          <span class="contact-channels__detail">CABA · Lunes a viernes de 9 a 17 h</span>
        </a>
      </div>
      <p class="contact-phone">¿Preferís llamarnos? <a href="tel:+541121272548">2127-2548</a></p>
    </div>

    <form class="contact-form footer-contact__form" action="https://mail.almatcerramientos.com.ar/almat-api/contact.php" method="POST" data-contact-form novalidate>
      <div class="footer-contact__form-heading">
        <h3>Contanos tu idea.</h3>
        <p>Nosotros te ayudamos a darle forma.</p>
      </div>
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" aria-label="Dejar vacío" maxlength="300" />
      <div class="form-grid">
        <div class="field">
          <label for="footer-nombre">Nombre y apellido *</label>
          <input id="footer-nombre" name="nombre" type="text" autocomplete="name" required minlength="2" maxlength="100" />
        </div>
        <div class="field">
          <label for="footer-email">Email *</label>
          <input id="footer-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        </div>
        <div class="field">
          <label for="footer-telefono">Teléfono</label>
          <input id="footer-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
        </div>
        <div class="field">
          <label for="footer-servicio">Servicio de interés *</label>
          <select id="footer-servicio" name="servicio" required>
            <option value="" selected disabled>Seleccioná una opción</option>
            <option>Aberturas de aluminio</option>
            <option>Cerramientos de aluminio</option>
            <option>Vidrios, espejos y templados</option>
            <option>Cerramientos corredizos y plegadizos</option>
            <option>Aberturas de PVC</option>
            <option>Otro / necesito asesoramiento</option>
          </select>
        </div>
        <div class="field field--full">
          <label for="footer-mensaje">Contanos sobre tu proyecto *</label>
          <textarea id="footer-mensaje" name="mensaje" required minlength="10" maxlength="3000"></textarea>
        </div>
      </div>
      <button class="form-submit cta cta--primary cta--light" type="submit"><span>Enviar consulta</span><span aria-hidden="true"><ArrowIcon /></span></button>
      <p class="form-note">Los datos se utilizan únicamente para responder tu consulta.</p>
      <p class="form-status" data-form-status aria-live="polite"></p>
      <noscript><p class="form-note">Para usar el formulario, activá JavaScript. También podés escribirnos por WhatsApp o email desde los enlaces de esta sección.</p></noscript>
    </form>
  </div>
</section>
