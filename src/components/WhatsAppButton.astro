---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsappUrl = 'https://wa.me/5491127332222?text=Hola%2C%20%C2%BFc%C3%B3mo%20est%C3%A1n%3F%20Quisiera%20consultar%20por%20cerramientos%20en%20ALMAT%20Cerramientos.%20%C2%BFMe%20podr%C3%ADan%20asesorar%3F';
---

<a
  class="whatsapp-float"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribinos por WhatsApp a ALMAT Cerramientos"
>
  <span class="whatsapp-float__tooltip" aria-hidden="true">Escribinos por WhatsApp</span>
  <img
    src={`${base}/brand/whatsapp-almat.webp`}
    width="272"
    height="272"
    alt=""
    decoding="async"
  />
</a>

<style>
  .whatsapp-float {
    position: fixed;
    z-index: 80;
    right: 30px;
    bottom: 30px;
    display: block;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    opacity: 1;
    transform: none;
    animation: whatsapp-enter 600ms var(--ease) 300ms backwards;
    -webkit-tap-highlight-color: transparent;
    transition: transform 280ms var(--ease), filter 280ms ease;
  }

  .whatsapp-float img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .whatsapp-float:hover {
    transform: scale(1.04);
    filter: drop-shadow(0 10px 14px rgba(10, 11, 10, .2));
  }

  .whatsapp-float:active {
    transform: scale(.97);
    transition-duration: 120ms;
  }

  .whatsapp-float:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 4px;
    box-shadow: 0 0 0 5px rgba(20, 21, 19, .82);
  }

  .whatsapp-float__tooltip {
    position: absolute;
    top: 50%;
    right: calc(100% + 12px);
    width: max-content;
    max-width: 15rem;
    padding: .62rem .8rem;
    border: 1px solid rgba(238, 234, 225, .16);
    background: rgba(20, 21, 19, .95);
    color: var(--paper);
    font-size: .7rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .025em;
    opacity: 0;
    pointer-events: none;
    transform: translate(6px, -50%);
    transition: opacity 280ms ease, transform 280ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 961px) {
    .whatsapp-float:hover .whatsapp-float__tooltip,
    .whatsapp-float:focus-visible .whatsapp-float__tooltip {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }

  @media (max-width: 960px) {
    .whatsapp-float {
      right: 24px;
      bottom: 24px;
      width: 62px;
      height: 62px;
    }

    .whatsapp-float__tooltip { display: none; }
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      right: 20px;
      bottom: calc(20px + env(safe-area-inset-bottom, 0px));
      width: 56px;
      height: 56px;
    }
  }

  @keyframes whatsapp-enter {
    from { opacity: 0; transform: translateY(10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

