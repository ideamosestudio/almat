---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div>
      <img src={`${base}/brand/almat-logo-white.png`} alt="ALMAT" width="220" height="74" loading="lazy" />
      <p>Aberturas y cerramientos que integran arquitectura, funcionalidad y calidad.</p>
    </div>
    <div class="footer-links">
      <span class="eyebrow">NAVEGACIÓN</span>
      <a href={`${base}/`}>Inicio</a>
      <a href={`${base}/nosotros/`}>Nosotros</a>
      <a href={`${base}/servicios/`}>Servicios</a>
      <a href={`${base}/contacto/`}>Contacto</a>
    </div>
    <div class="footer-links">
      <span class="eyebrow">CONTACTO</span>
      <a href="mailto:almatcerramientos@gmail.com">almatcerramientos@gmail.com</a>
      <a href="tel:+541121272548">2127-2548</a>
      <a href="https://wa.me/5491127332222" target="_blank" rel="noreferrer">WhatsApp 11 2733-2222</a>
      <a href="https://maps.google.com/?q=Av.+Raúl+Scalabrini+Ortiz+1022,+CABA" target="_blank" rel="noreferrer">Scalabrini Ortiz 1022, CABA ↗</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} ALMAT Cerramientos</span>
    <span>Buenos Aires, Argentina</span>
  </div>
</footer>

