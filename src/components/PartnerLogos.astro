---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  { name: 'Aluar', file: 'aluar.webp' },
  { name: 'Metales del Talar', file: 'mdt.webp' },
  { name: 'Tanit', file: 'tanit.webp' },
  { name: 'Giesse', file: 'giesse.webp' },
  { name: 'Red Ekoglass', file: 'red-ekoglass.webp' }
];
---

<div class="partner-logos reveal-up" role="list" aria-label="Marcas y proveedores">
  {partners.map((partner) => (
    <div class="partner-logos__item" role="listitem">
      <img
        src={`${base}/partners/${partner.file}`}
        alt={partner.name}
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
</div>
