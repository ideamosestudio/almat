---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  light?: boolean;
  external?: boolean;
}

const {
  href,
  label,
  variant = 'primary',
  light = false,
  external = false
} = Astro.props;
---
<a
  class:list={['cta', `cta--${variant}`, { 'cta--light': light }]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
>
  <span>{label}</span>
</a>
